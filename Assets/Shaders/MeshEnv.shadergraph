    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "Inside = Position.x >= Min.x && Position.y >= Min.y && Position.z >= Min.z && Position.x <= Max.x && Position.y <= Max.y && Position.z <= Max.z;"
